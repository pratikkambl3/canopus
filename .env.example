# ============================================================
# CANOPUS — Environment Configuration Example
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# ============================================================

# ── Application ─────────────────────────────────────────────
APP_ENV=production

# ── Ports ───────────────────────────────────────────────────
# Port the frontend (Nginx) is exposed on the host
FRONTEND_PORT=3000
# Port the backend (Express) listens on inside Docker
BACKEND_PORT=8000

# ── PostgreSQL ──────────────────────────────────────────────
# The service name 'postgres' is used as DB_HOST so Docker DNS resolves it
DB_HOST=postgres
DB_PORT=5432
DB_NAME=canopus_db
DB_USER=canopus
DB_PASSWORD=change_me_strong_password

# ── JWT ─────────────────────────────────────────────────────
# Generate a strong random secret: openssl rand -base64 64
JWT_SECRET=change_me_generate_a_strong_random_secret
JWT_EXPIRES_IN=24h

# ── Admin credentials ────────────────────────────────────────
# Single admin user for the /admin panel
ADMIN_EMAIL=admin@canopus.local
ADMIN_PASSWORD=change_me_strong_password

# ── CORS ────────────────────────────────────────────────────
# Comma-separated list of allowed origins (no trailing slash)
# For production, set to your actual domain, e.g. https://canopus.example.com
CORS_ORIGINS=http://localhost:3000

# ── Public URL ──────────────────────────────────────────────
# Base URL of the app, used to construct absolute media URLs
# Leave empty for relative URLs (recommended when Nginx proxies everything)
PUBLIC_URL=

# ── Vite (frontend build-time) ───────────────────────────────
# The API base URL seen by the React app.
# /api works in Docker because Nginx proxies it to the backend.
# For local `npm run dev`, set to http://localhost:8000
VITE_API_URL=/api
VITE_PAYMENT_UPI_ID=pratik.kamble11@ybl
VITE_PAYMENT_PAYEE_NAME=Pratik Prakash Kamble
VITE_PAYMENT_QR_IMAGE_URL=/payment-qr.png

# ── Digital Products & Payment ──────────────────────────────
DIGITAL_PRODUCTS_PATH=/data/digital-products
STORAGE_PATH=/data
PAYMENT_UPI_ID=pratik.kamble11@ybl
PAYMENT_PAYEE_NAME=Pratik Prakash Kamble
PAYMENT_QR_IMAGE_URL=/payment-qr.png
PREVIEW_DURATION_SECONDS=30

# ── Support & Email (SMTP) ──────────────────────────────────
SUPPORT_EMAIL=support@canopus.live
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@canopus.live
SMTP_PASS=change_me_smtp_password
SMTP_FROM="CANOPUS" <no-reply@canopus.live>

